# Copy to backend/.env. Never commit real secrets. Never put keys in frontend code.

ALLOWED_ORIGIN=http://localhost:3000
PORT=4000
# local or supabase. Cloud mode never falls back to disk on a failed request.
SENTINELQ_STORAGE_PROVIDER=local
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Backend secret key from Supabase Settings > API Keys. Never use in frontend.
SUPABASE_SECRET_KEY=
SENTINELQ_STORAGE_KEY=CHANGE_ME_random_value_at_least_32_characters
SENTINELQ_AUDIT_KEY=CHANGE_ME_separate_random_value_at_least_32_characters
SENTINELQ_ADMIN_PASSWORD=CHANGE_ME_unique_admin_password_16_chars_minimum
# Local demo only: set SENTINELQ_ALLOW_DEMO_ADMIN=1 with SENTINELQ_ADMIN_PASSWORD=admin.
# Never enable this on a deployed server.
SENTINELQ_JUDICIAL_ACCESS_KEY=CHANGE_ME_separate_random_judicial_key_at_least_32_characters
SENTINELQ_INVESTIGATOR_PASSWORD=CHANGE_ME_unique_investigator_password_16_chars_minimum
SENTINELQ_AUDITOR_PASSWORD=CHANGE_ME_unique_auditor_password_16_chars_minimum
SENTINELQ_MANAGER_PASSWORD=CHANGE_ME_unique_manager_password_16_chars_minimum
SENTINELQ_SEED_DEMO=0
SENTINELQ_REQUIRE_HTTPS=0
SENTINELQ_TRUST_PROXY=0
SENTINELQ_FFMPEG_PATH=ffmpeg

# Optional AI. Core reporting works without these.
# Local / no-cost: Ollama or LM Studio OpenAI-compatible endpoint
AI_BASE_URL=
AI_MODEL=llama3
OPENAI_API_KEY=

# Gemini (used for investigator briefing and optional rewrite assistance)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
