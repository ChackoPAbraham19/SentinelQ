# SentinelQ backend configuration
# -----------------------------------------------------------------------------
# 1. Copy this file to backend/.env   (cp backend/.env.example backend/.env)
# 2. Replace EVERY "replace-..." value with its own random secret.
#    Placeholder values deliberately fail startup validation.
# 3. Never commit backend/.env. It is ignored by git.
#
# Generate one random secret per line with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Upgrading an existing install? NEVER change STORAGE/AUDIT/JUDICIAL keys:
# existing cases, audit logs and locations can only be read with the same keys.
# -----------------------------------------------------------------------------

# ---- Server ------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Browser origin allowed to call the API (the frontend dev server by default).
ALLOWED_ORIGIN=http://localhost:3000

# ---- Required secrets (min. 32 characters, each value independent) -----------
# Wraps every per-case encryption key.
SENTINELQ_STORAGE_KEY=replace-with-an-independent-random-storage-key
# Signs the tamper-evident audit chain and evidence ledger.
SENTINELQ_AUDIT_KEY=replace-with-an-independent-random-audit-key
# Second envelope for exact locations and sensitive case details.
SENTINELQ_JUDICIAL_ACCESS_KEY=replace-with-an-independent-random-judicial-key

# ---- Authority accounts (min. 16 characters each, all different) -------------
# Usernames are admin, manager, investigator and auditor.
SENTINELQ_ADMIN_PASSWORD=replace-with-a-unique-admin-password
SENTINELQ_MANAGER_PASSWORD=replace-with-a-unique-manager-password
SENTINELQ_INVESTIGATOR_PASSWORD=replace-with-a-unique-investigator-password
SENTINELQ_AUDITOR_PASSWORD=replace-with-a-unique-auditor-password

# ---- Storage -----------------------------------------------------------------
# local = encrypted files on disk; supabase = Postgres + private bucket.
SENTINELQ_STORAGE_PROVIDER=local
# Local storage folder (absolute path). Defaults to backend/data.
# SENTINELQ_DATA_DIR=/absolute/path/to/backend/data

# Supabase (only when SENTINELQ_STORAGE_PROVIDER=supabase). Backend-only secret:
# never put it in frontend code. Setup steps: docs/DATABASE.md
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key

# ---- Local demo switches -------------------------------------------------------
# 1 = seed synthetic demo cases on startup.
SENTINELQ_SEED_DEMO=0
# 1 = allow admin/admin login. Works only on loopback with NODE_ENV != production.
SENTINELQ_ALLOW_DEMO_ADMIN=0

# ---- Deployment (see docs/DEPLOYMENT.md) ---------------------------------------
# Set both to 1 behind a trusted HTTPS reverse proxy (e.g. Render).
SENTINELQ_REQUIRE_HTTPS=0
SENTINELQ_TRUST_PROXY=0
# 1 = serve the built frontend from the API process (single-service hosting).
# SENTINELQ_SERVE_FRONTEND=0
# Scales the per-route rate limits (default 1).
# SENTINELQ_RATE_LIMIT_MULTIPLIER=1

# ---- Media tools ---------------------------------------------------------------
# Only needed if ffmpeg/ffprobe are not on PATH.
# SENTINELQ_FFMPEG_PATH=/usr/bin/ffmpeg
# SENTINELQ_FFPROBE_PATH=/usr/bin/ffprobe

# ---- Optional AI assistance (core reporting works without any of these) -------
# Gemini: investigator briefing and optional rewrite assistance.
# GEMINI_API_KEY=replace-with-your-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash
# Or any OpenAI-compatible endpoint (e.g. local Ollama / LM Studio).
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3
# OPENAI_API_KEY=
